# ---------------------------------------------------------------------------
# Identity provider (Okta, or any OIDC provider with token introspection)
#
# This is the identity the CALLER presents. It answers "who is asking", and n8n
# turns it into the key your stored Google token is filed under.
# ---------------------------------------------------------------------------

# Issuer URL of a CUSTOM authorization server, not your org's default one.
# Okta Integrator tenants ship with one called "default", but you should create a
# dedicated one so its audience identifies your n8n instance specifically.
# Sanity check: <issuer>/.well-known/openid-configuration must expose an
# "introspection_endpoint". If it does not, you have the wrong server.
OKTA_ISSUER=https://your-tenant.okta.com/oauth2/aus000000000000000

# From the OIDC app integration you register for this app.
# It must be a CONFIDENTIAL client (Okta calls this a "Web Application"): n8n's
# resolver reuses these same credentials to introspect the tokens it receives, and
# a public client has no secret to introspect with.
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# Scopes this app requests. openid/profile/email identify the user; offline_access
# returns a refresh token so the session outlives the 1 hour access token. The last
# entry is a custom scope you define on the authorization server — rename or drop it,
# but keep it identical to what you created or the provider rejects the whole request.
OKTA_SCOPES=openid profile email offline_access n8n.invoke

# Which claim from the introspection response identifies the user. Must match the
# Subject Claim configured on the n8n resolver. Used here only to label the Token
# page; n8n is the one that decides for real.
# Prefer an immutable claim. On Okta access tokens `sub` is the login (an email
# address), which changes when someone is renamed and can be reassigned to a
# different person later; `uid` is the immutable user ID.
SUBJECT_CLAIM=uid

# ---------------------------------------------------------------------------
# This app
# ---------------------------------------------------------------------------

# Port the demo listens on. Ignored on Vercel, which assigns its own.
PORT=3000

# Public base URL of this app. Must match the sign-in redirect URI you registered
# with the identity provider, which is <APP_BASE_URL>/callback. No trailing slash.
# Deployed, this is the deployment's own https URL, not localhost — it is read once at
# startup, so changing it needs a redeploy rather than just an env update.
APP_BASE_URL=http://localhost:3000

# Signing key for the session cookie. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Redis connection string for the session store, e.g. rediss://...
# Leave empty locally: sessions then live in memory, which is fine for one process.
# Required on any serverless host, where invocations do not share memory and the
# in-memory store loses the PKCE state between /login and /callback.
REDIS_URL=

# ---------------------------------------------------------------------------
# n8n
# ---------------------------------------------------------------------------

# Base URL of your n8n instance, no trailing slash.
N8N_BASE_URL=https://n8n.example.com

# ID of the workflow whose credential readiness this app checks. Copy it from the
# editor URL: https://n8n.example.com/workflow/<this part>
N8N_WORKFLOW_ID=

# Production webhook URL of that workflow's Webhook trigger. Only answers once the
# workflow is published.
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/end-user-gmail

# Optional. Production webhook of the companion "connected account" workflow. Lets
# the credentials page show which Google account each connection actually uses.
# Leave blank and that column stays empty; nothing else changes.
N8N_ACCOUNT_WEBHOOK_URL=https://n8n.example.com/webhook/connected-account

# Shared secret gating n8n's external dynamic-credential endpoints. Set the SAME
# value as N8N_DYNAMIC_CREDENTIALS_ENDPOINT_AUTH_TOKEN on the n8n instance and
# restart it. Sent by this app as "x-authorization: Bearer <token>".
# Without it those endpoints return HTTP 500 by design, not 401.
N8N_ENDPOINT_AUTH_TOKEN=
